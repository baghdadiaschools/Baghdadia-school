{
  "name": "baghdadia-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/server.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
